---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import SeriesCard from '../components/SeriesCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { bySeries, hrefFor, sortArticles } from '../lib/articles';
import { SERIES, SERIES_ORDER } from '../lib/series';
import { withBase } from '../lib/paths';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const recentArticles = sortArticles(allArticles)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const firstArticle = bySeries(allArticles, 'cuda')[0];
---

<SiteLayout>
  <section class="relative overflow-hidden pb-24 pt-28">
    <div class="pointer-events-none absolute inset-0">
      <div class="home-bg-grid absolute inset-0"></div>
      <div class="absolute left-1/4 top-0 h-[500px] w-[500px] rounded-full bg-blue-500/[0.08] blur-[120px] dark:bg-blue-500/[0.12]"></div>
      <div class="absolute right-1/4 top-20 h-[400px] w-[400px] rounded-full bg-violet-500/[0.06] blur-[120px] dark:bg-violet-500/[0.10]"></div>
      <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-[#fafafa] to-transparent dark:from-[#0a0a0a]"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
      <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white/80 px-4 py-1.5 text-sm text-gray-600 backdrop-blur-sm dark:border-white/10 dark:bg-white/5 dark:text-gray-400">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500"></span>
        开源嵌入式与端侧 AI 学习指南
      </div>

      <h1 class="mb-6 text-5xl font-bold tracking-tight md:text-6xl lg:text-7xl">
        <span class="bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 bg-clip-text text-transparent dark:from-white dark:via-gray-200 dark:to-white">
          EE & Edge AI
        </span>
        <span class="bg-gradient-to-r from-[#007aff] via-[#5856D6] to-[#AF52DE] bg-clip-text text-transparent">
          Guide
        </span>
      </h1>

      <p class="mb-3 text-lg font-medium text-gray-600 dark:text-gray-400 md:text-xl">
        从嵌入式底层到 CUDA/NPU 与 RKNN 部署的系统化知识库
      </p>
      <p class="mx-auto mb-10 max-w-xl text-sm leading-relaxed text-gray-500 dark:text-gray-500">
        面向嵌入式工程师的端侧 AI 学习路径：C/C++、ARM、STM32、CUDA 算子、模型转换、量化、板端推理与性能调优。
      </p>

      <div class="flex flex-col justify-center gap-3 sm:flex-row">
        {firstArticle && (
          <a href={withBase(hrefFor(firstArticle))} class="group inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl bg-gray-900 px-8 py-3.5 font-semibold text-white shadow-lg shadow-gray-900/10 transition-all duration-300 hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:shadow-white/10 dark:hover:bg-gray-100">
            开始学习
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
        )}
        <button type="button" onclick="document.dispatchEvent(new Event('open-search'))" class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-gray-200 bg-white px-8 py-3.5 font-semibold text-gray-700 transition-all duration-300 hover:border-gray-300 hover:bg-gray-50 dark:border-white/10 dark:bg-white/5 dark:text-gray-300 dark:hover:border-white/20 dark:hover:bg-white/10">
          全文搜索
        </button>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-14 text-center">
        <h2 class="mb-3 text-3xl font-bold text-gray-900 dark:text-white">知识库</h2>
        <p class="mx-auto max-w-md text-gray-500 dark:text-gray-400">系统化的嵌入式与端侧 AI 技术文档</p>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {SERIES_ORDER.map((id) => <SeriesCard series={SERIES[id]} count={bySeries(allArticles, id).length} />)}
      </div>
    </div>
  </section>

  <section class="border-t border-gray-100 py-20 dark:border-white/[0.04]">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-14 text-center">
        <h2 class="mb-3 text-3xl font-bold text-gray-900 dark:text-white">最近文章</h2>
        <p class="mx-auto max-w-md text-gray-500 dark:text-gray-400">最近迁移与整理的技术笔记</p>
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {recentArticles.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>
</SiteLayout>
