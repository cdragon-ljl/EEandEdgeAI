---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SeriesSidebar from '../../components/SeriesSidebar.astro';
import { bySeries } from '../../lib/articles';
import { withBase } from '../../lib/paths';
import { SERIES, SERIES_ORDER, type SeriesId } from '../../lib/series';

export function getStaticPaths() {
  return SERIES_ORDER.map((series) => ({ params: { series }, props: { series } }));
}

interface Props {
  series: SeriesId;
}

const { series } = Astro.props;
const meta = SERIES[series];
const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const articles = bySeries(allArticles, series);
---

<SiteLayout title={meta.title} description={meta.description}>
  <section class="border-b border-gray-100 dark:border-white/[0.04]">
    <div class="mx-auto max-w-[1320px] px-6 pt-10">
      <img
        src={withBase(meta.cover.src)}
        width={meta.cover.width}
        height={meta.cover.height}
        alt={meta.cover.alt}
        decoding="async"
        fetchpriority="high"
        class="block h-auto w-full object-contain"
      />
    </div>
    <div class="mx-auto max-w-5xl px-6 pb-14 pt-9 text-center">
      <p class="mb-4 inline-flex rounded-full border border-gray-200 bg-white px-4 py-1.5 text-sm text-gray-600 dark:border-white/10 dark:bg-white/5 dark:text-gray-400">
        {meta.label}
      </p>
      <h1 class="mb-4 text-4xl font-bold text-gray-900 dark:text-white md:text-5xl">
        {meta.title}
      </h1>
      <p class="mx-auto max-w-2xl text-base leading-8 text-gray-500 dark:text-gray-400">
        {meta.description}
      </p>
    </div>
  </section>

  <main class="mx-auto grid max-w-[1320px] gap-8 px-6 py-12 lg:grid-cols-[260px_minmax(0,1fr)]">
    <aside class="hidden lg:block">
      <SeriesSidebar articles={articles} series={series} />
    </aside>
    <section class="grid gap-5 md:grid-cols-2">
      {articles.map((article) => <ArticleCard article={article} />)}
    </section>
  </main>
</SiteLayout>
