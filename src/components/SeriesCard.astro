---
import type { SeriesMeta } from '../lib/series';
import { withBase } from '../lib/paths';

interface Props {
  series: SeriesMeta;
  count: number;
}

const { series, count } = Astro.props;
const gradientMap = {
  blue: { from: '#3B82F6', to: '#8B5CF6', glow: 'rgba(99,102,241,0.15)' },
  emerald: { from: '#10B981', to: '#06B6D4', glow: 'rgba(16,185,129,0.15)' },
  violet: { from: '#8B5CF6', to: '#EC4899', glow: 'rgba(139,92,246,0.15)' },
  indigo: { from: '#6366F1', to: '#0EA5E9', glow: 'rgba(99,102,241,0.15)' },
  amber: { from: '#F59E0B', to: '#EF4444', glow: 'rgba(245,158,11,0.15)' },
  cyan: { from: '#06B6D4', to: '#14B8A6', glow: 'rgba(6,182,212,0.15)' },
  rose: { from: '#F43F5E', to: '#FB7185', glow: 'rgba(244,63,94,0.15)' },
};
const gradient = gradientMap[series.accent];
const iconPath = {
  cuda: 'M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 0 0 2.25-2.25V6.75a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 6.75v10.5a2.25 2.25 0 0 0 2.25 2.25Zm.75-12h9v9h-9v-9Z',
  'ee-system': 'M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25A8.966 8.966 0 0 1 18 3.75c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25',
  rknn: 'M3.75 13.5 14.25 2.25 12 10.5h8.25L9.75 21.75 12 13.5H3.75Z',
  riscv: 'M5.25 3.75h13.5v16.5H5.25V3.75Zm3 3v10.5h7.5V6.75H8.25Zm1.5 1.5h4.5v1.5H9.75v-1.5Zm0 3h4.5v1.5H9.75v-1.5Zm0 3h3v1.5h-3v-1.5Z',
  zephyr: 'M12 2.25 4.5 20.25h6l-1.5-6h6l-1.5 6h6L12 2.25Zm0 4.8 2.1 5.7H9.9L12 7.05Z',
  bsp: 'M3.75 19.5V4.5h16.5v15H3.75Zm3-12v9h10.5v-9H6.75Zm2.25 2.25h6v4.5H9v-4.5Z',
  'video-audio': 'M15.75 10.5V6.75A2.25 2.25 0 0 0 13.5 4.5h-9A2.25 2.25 0 0 0 2.25 6.75v10.5A2.25 2.25 0 0 0 4.5 19.5h9a2.25 2.25 0 0 0 2.25-2.25V13.5L21 16.5v-9l-5.25 3Z',
}[series.id];
---

<a
  href={withBase(series.href)}
  class="group relative block cursor-pointer rounded-2xl border border-gray-200 bg-white p-6 transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1 hover:border-gray-300 hover:shadow-xl dark:border-white/[0.06] dark:bg-white/[0.03] dark:hover:border-white/[0.12]"
>
  <div class="pointer-events-none absolute inset-0 rounded-2xl opacity-0 transition-opacity duration-500 group-hover:opacity-100" style={`background: radial-gradient(ellipse at 50% 0%, ${gradient.glow}, transparent 70%);`}></div>
  <div class="absolute left-6 right-6 top-0 h-[2px] rounded-full opacity-0 transition-opacity duration-300 group-hover:opacity-100" style={`background: linear-gradient(90deg, ${gradient.from}, ${gradient.to});`}></div>

  <div class="relative z-10">
    <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl transition-transform duration-300 group-hover:scale-110" style={`background: linear-gradient(135deg, ${gradient.from}20, ${gradient.to}20);`}>
      <svg class="h-5 w-5" style={`color: ${gradient.from};`} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6">
        <path stroke-linecap="round" stroke-linejoin="round" d={iconPath} />
      </svg>
    </div>

    <h3 class="mb-1.5 text-base font-semibold text-gray-900 transition-colors duration-200 dark:text-white">
      {series.title}
    </h3>
    <p class="mb-4 line-clamp-2 text-sm leading-relaxed text-gray-500 dark:text-gray-400">
      {series.description}
    </p>

    <div class="flex items-center justify-between">
      <span class="text-xs font-medium text-gray-400 dark:text-gray-500">{count} 篇文章</span>
      <span class="flex translate-x-[-4px] items-center gap-1 text-xs font-medium opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100" style={`color: ${gradient.from};`}>
        探索
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </span>
    </div>
  </div>
</a>
