---
import type { Article } from '../lib/articles';
import { hrefFor } from '../lib/articles';
import { SERIES } from '../lib/series';
import { withBase } from '../lib/paths';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const meta = SERIES[article.data.series];
---

<a
  href={withBase(hrefFor(article))}
  class="group block cursor-pointer rounded-2xl border border-gray-200 bg-white p-6 transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1 hover:border-gray-300 hover:shadow-xl dark:border-white/[0.06] dark:bg-white/[0.03] dark:hover:border-white/[0.12]"
>
  <div class="mb-3 flex flex-wrap gap-2">
    <span class="rounded-md bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 dark:bg-white/[0.06] dark:text-gray-400">{meta.shortTitle}</span>
    <span class="rounded-md bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 dark:bg-white/[0.06] dark:text-gray-400">第 {article.data.order} 篇</span>
  </div>
  <h3 class="mb-2 flex items-start gap-2 text-lg font-semibold text-gray-900 transition-colors duration-200 group-hover:text-[#007aff] dark:text-white dark:group-hover:text-[#0a84ff]">
    <svg class="mt-0.5 h-5 w-5 shrink-0 text-[#007aff] opacity-70 dark:text-[#0a84ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
    </svg>
    <span>{article.data.title}</span>
  </h3>
  <p class="mb-4 line-clamp-2 text-sm leading-relaxed text-gray-500 dark:text-gray-400">{article.data.description}</p>
  <time class="text-xs font-medium text-gray-400 dark:text-gray-500" datetime={article.data.pubDate.toISOString()}>
    {article.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
  </time>
</a>
