---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth > 1 && heading.depth < 4);
---

<div class="sticky top-24 w-56">
  <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">本文目录</p>
  {items.length > 0 ? (
    <nav class="space-y-1" aria-label="文章章节">
      {items.map((heading) => (
        <a
          href={`#${heading.slug}`}
          class:list={[
            'block rounded-md py-1.5 text-sm leading-5 text-gray-500 transition-colors hover:text-[#007aff] dark:text-gray-400 dark:hover:text-[#0a84ff]',
            heading.depth === 3 ? 'pl-4' : 'pl-0 font-medium',
          ]}
        >
          {heading.text}
        </a>
      ))}
    </nav>
  ) : (
    <p class="text-sm text-gray-400 dark:text-gray-500">暂无章节目录</p>
  )}
</div>
