---
import ThemeToggle from './ThemeToggle.astro';
import { SERIES, SERIES_ORDER } from '../lib/series';
import { withBase } from '../lib/paths';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(withBase(href)) || currentPath.startsWith(href);

const DESKTOP_NAV_ITEMS_PER_ROW = 8;
const desktopNavRows = [
  SERIES_ORDER.slice(0, DESKTOP_NAV_ITEMS_PER_ROW),
  SERIES_ORDER.slice(DESKTOP_NAV_ITEMS_PER_ROW, DESKTOP_NAV_ITEMS_PER_ROW * 2),
].filter((row) => row.length > 0);

if (SERIES_ORDER.length > DESKTOP_NAV_ITEMS_PER_ROW * 2) {
  throw new Error('Desktop navigation supports at most 16 series.');
}

const navLinkClass = (active: boolean) =>
  [
    'nav-link inline-flex h-9 items-center rounded-lg border-b-2 px-2 text-[12px] transition-colors duration-200',
    active
      ? 'border-[#007aff] bg-gray-100/70 font-semibold text-gray-900 dark:border-[#0a84ff] dark:bg-white/[0.08] dark:text-white'
      : 'border-transparent font-medium text-gray-500 hover:bg-gray-100/70 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/[0.06] dark:hover:text-white',
  ].join(' ');

const mobileNavLinkClass = (active: boolean) =>
  [
    'mobile-nav-link flex items-center gap-3 rounded-xl px-4 py-3 text-[13px] transition-all cursor-pointer',
    active
      ? 'bg-gray-100 font-semibold text-gray-900 dark:bg-white/[0.08] dark:text-white'
      : 'font-medium text-gray-600 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/[0.04] dark:hover:text-white',
  ].join(' ');
---

<header id="site-header" class="fixed left-0 right-0 top-0 z-50 border-b border-gray-200/50 bg-white/70 backdrop-blur-xl transition-all duration-300 dark:border-white/[0.08] dark:bg-white/[0.06]">
  <nav class="relative mx-auto grid h-16 max-w-[1440px] grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 px-4 sm:px-6 xl:h-24 xl:grid-cols-[150px_minmax(0,1fr)_132px] xl:gap-x-4">
    <a href={withBase('/')} class="cursor-pointer text-lg font-bold sm:text-xl xl:justify-self-start">
      <span class="bg-gradient-to-r from-[#007aff] to-[#5ac8fa] bg-clip-text text-transparent">
        EE & Edge AI
      </span>
    </a>

    <div class="hidden min-w-0 flex-col items-stretch justify-center gap-1 xl:flex">
      {desktopNavRows.map((row) => (
        <ul class="flex h-9 items-center justify-center gap-1">
          {row.map((id) => {
            const item = SERIES[id];
            const active = isActive(item.href);
            return (
              <li>
                <a href={withBase(item.href)} class={navLinkClass(active)}>
                  {item.shortTitle}
                </a>
              </li>
            );
          })}
        </ul>
      ))}
    </div>

    <div class="flex items-center justify-self-end gap-0.5">
      <a
        href="https://github.com/cdragon-ljl/EEandEdgeAI"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-lg p-2 text-gray-500 transition-colors duration-200 hover:bg-gray-100/70 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/[0.06] dark:hover:text-white md:flex"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
        </svg>
      </a>

      <button
        type="button"
        class="rounded-lg p-2 text-gray-500 transition-colors duration-200 hover:bg-gray-100/70 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/[0.06] dark:hover:text-white"
        aria-label="搜索"
        title="搜索 (Cmd/Ctrl + K)"
        data-open-search
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0z" />
        </svg>
      </button>

      <ThemeToggle />

      <button
        id="mobile-menu-btn"
        type="button"
        class="rounded-lg p-2 text-gray-500 transition-colors duration-200 hover:bg-gray-100/70 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/[0.06] dark:hover:text-white xl:hidden"
        aria-label="菜单"
      >
        <svg id="menu-icon" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path class="menu-open" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          <path class="menu-close hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu-overlay"
    class="fixed inset-0 z-40 bg-black/40 opacity-0 pointer-events-none backdrop-blur-sm transition-opacity duration-300 xl:hidden"
  ></div>

  <div
    id="mobile-menu"
    class="fixed right-0 top-0 z-50 h-[100dvh] w-72 max-w-[80vw] translate-x-full overflow-y-auto overscroll-contain bg-white/95 shadow-2xl backdrop-blur-xl transition-transform duration-300 ease-out dark:bg-[#141414]/95 xl:hidden"
  >
    <div class="min-h-full p-6">
      <div class="mb-2 flex items-center justify-between">
        <span class="text-sm font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">导航</span>
        <button id="mobile-menu-close" type="button" class="rounded-lg p-2 transition-colors hover:bg-gray-100 dark:hover:bg-white/[0.06]" aria-label="关闭菜单">
          <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="mb-6">
        <p class="mb-2 px-4 text-[11px] font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">知识库</p>
        <nav class="flex flex-col gap-0.5">
          {SERIES_ORDER.map((id) => {
            const item = SERIES[id];
            return <a href={withBase(item.href)} class={mobileNavLinkClass(isActive(item.href))}>{item.shortTitle}</a>;
          })}
        </nav>
      </div>

      <div class="border-t border-gray-100 pt-4 dark:border-white/[0.06]">
        <p class="mb-2 px-4 text-[11px] font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">更多</p>
        <nav class="flex flex-col gap-0.5">
          <button type="button" data-open-search class="mobile-nav-link flex cursor-pointer items-center gap-3 rounded-xl px-4 py-3 text-[13px] font-medium text-gray-600 transition-all hover:bg-gray-50 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/[0.04] dark:hover:text-white">全文搜索</button>
          <a href="https://github.com/cdragon-ljl/EEandEdgeAI" target="_blank" rel="noopener noreferrer" class="mobile-nav-link flex cursor-pointer items-center gap-3 rounded-xl px-4 py-3 text-[13px] font-medium text-gray-600 transition-all hover:bg-gray-50 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/[0.04] dark:hover:text-white">
            GitHub
            <svg class="ml-auto h-3 w-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenuClose = document.getElementById('mobile-menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
  const menuIcon = document.getElementById('menu-icon');

  function openMenu() {
    mobileMenu?.classList.remove('translate-x-full');
    mobileMenuOverlay?.classList.remove('opacity-0', 'pointer-events-none');
    mobileMenuOverlay?.classList.add('opacity-100', 'pointer-events-auto');
    document.body.style.overflow = 'hidden';
    menuIcon?.querySelector('.menu-open')?.classList.add('hidden');
    menuIcon?.querySelector('.menu-close')?.classList.remove('hidden');
  }

  function closeMenu() {
    mobileMenu?.classList.add('translate-x-full');
    mobileMenuOverlay?.classList.remove('opacity-100', 'pointer-events-auto');
    mobileMenuOverlay?.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
    menuIcon?.querySelector('.menu-open')?.classList.remove('hidden');
    menuIcon?.querySelector('.menu-close')?.classList.add('hidden');
  }

  mobileMenuBtn?.addEventListener('click', openMenu);
  mobileMenuClose?.addEventListener('click', closeMenu);
  mobileMenuOverlay?.addEventListener('click', closeMenu);
  document.querySelectorAll('.mobile-nav-link').forEach((link) => link.addEventListener('click', closeMenu));
  document.querySelectorAll('[data-open-search]').forEach((trigger) => {
    trigger.addEventListener('click', () => document.dispatchEvent(new Event('open-search')));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
